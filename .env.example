# Copy this file to .env and adjust the values. Never commit .env.

# PostgreSQL connection string (matches the Docker Compose database we add later)
DATABASE_URL=postgresql://hr_user:change_me@localhost:5432/hr_assistant

# One of: debug, info, warn, error
LOG_LEVEL=info

# Chat model for answers (NVIDIA API Catalog). Get a key at https://build.nvidia.com
# and read the terms yourself first. Use only synthetic documents with this API.
NVIDIA_API_KEY=
# Model id, for example one marked "Free Endpoint" on build.nvidia.com
NVIDIA_MODEL=
